---
import { admissionsSummary } from "../../lib/admissionsSummary";
import Layout from "../../layouts/Layout.astro";
import LandingPage, {
    LANGUAGES,
    translations,
} from "../../components/LandingPage";

export function getStaticPaths() {
    return LANGUAGES.filter((l) => l.code !== "zh-HK").map((l) => ({
        params: { lang: l.code.toLowerCase() },
        props: { code: l.code },
    }));
}

const { lang } = Astro.params;
const { code } = Astro.props;
const t = translations[code] || translations["en"];

// SEO Metadata logic
const isChinese = code.startsWith("zh");
const appName = isChinese ? "DSE Jupas 神器" : "DSE Jupas";
const title = isChinese
    ? `JUPAS 计分器 2027｜${appName} · 免费计分、收生位置、面试练习`
    : "JUPAS Calculator 2027 | DSE Jupas · Score, Admission Positions & Interview Practice";
const seoDescription = isChinese
    ? `JUPAS 2027 升学规划：查 ${admissionsSummary.programmeCount} 个课程资料及 ${admissionsSummary.score2026Count} 个课程的 2026 历史收分。免费未加权 Best 5 试算，再按课程公式适用年份核对；App 提供课程计分与面试练习。`
    : `JUPAS calculator for 2027 planning: ${admissionsSummary.programmeCount} programme profiles and 2026 historical scores for ${admissionsSummary.score2026Count}. Try unweighted Best 5, then check each formula's applicable year. App scoring and interview practice available.`;
const description = seoDescription;
---

<Layout title={title} description={description} lang={code}>
    <main>
        <LandingPage client:load initialLang={code} admissionsSummary={admissionsSummary} />
    </main>
</Layout>
