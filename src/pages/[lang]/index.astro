---
import Layout from "../../layouts/Layout.astro";
import LandingPage, {
    LANGUAGES,
    translations,
} from "../../components/LandingPage";

export function getStaticPaths() {
    return LANGUAGES.filter((l) => l.code !== "zh-HK").map((l) => ({
        params: { lang: l.code.toLowerCase() },
        props: { code: l.code },
    }));
}

const { lang } = Astro.params;
const { code } = Astro.props;
const t = translations[code] || translations["en"];

// SEO Metadata logic
const isChinese = code.startsWith("zh");
const appName = isChinese ? "DSE Jupas 神器" : "DSE Jupas";
const title = isChinese
    ? `JUPAS 计分器｜${appName} · 免费计分、收生位置、面试练习`
    : "JUPAS Calculator | DSE Jupas · Score, Admission Positions & Interview Practice";
const seoDescription = isChinese
    ? "DSE Jupas 神器：免费 JUPAS 计分器。输入 DSE 成绩，即按 417 个课程公式计分，对比历年 Median、LQ，再看出路评级及练习大学面试。iPhone、Android 免费下载。"
    : "DSE Jupas: a free JUPAS calculator. Score your DSE results against 417 programmes' formulas, compare with past median and LQ, check outcome ratings and practise university interviews. Free on iPhone and Android.";
const description = seoDescription;
---

<Layout title={title} description={description} lang={code}>
    <main>
        <LandingPage client:load initialLang={code} />
    </main>
</Layout>
