---
import Layout from '../../layouts/Layout.astro';
import { snapshot, schools, programmesFor, has2026, formatScore, programmePath, latestRow, institutionNames } from '../../lib/admissions';
import '../../styles/universities.css';
import '../../styles/score-hub.css';

const schoolEntries = Object.entries(schools).map(([slug, school]) => {
  const programmes = programmesFor(school.code).sort((a, b) => a.js_code.localeCompare(b.js_code));
  const published = programmes.filter(has2026);
  return { slug, school, programmes, published };
});
const publishedSchools = schoolEntries.filter(({ published }) => published.length > 0);
const publishedCount = snapshot.programmes.filter(has2026).length;
const updatedDate = snapshot.sourceUpdatedAt.slice(0, 10);
const displayDate = updatedDate.replaceAll('-', ' / ');
const sources = publishedSchools.flatMap(({ slug, school, published }) =>
  [...new Set(published.map(p => p.actual_2026_source).filter(Boolean))]
    .map((href, index) => ({ href, id: `source-${slug}-${index}`, school }))
);
---
<Layout title="JUPAS 收分 2026｜各大學全部課程收生分數、Median／LQ 一覽" description={`同一頁查閱全部 ${snapshot.programmes.length} 個 JUPAS 課程的收生分數、資料年份及官方來源，可按院校、年份、名稱或 JS 代碼搜尋。${publishedCount} 個課程已有 2026 數字，其餘列最近有資料的年份，平均分與 Median 分開標示。`} schemaType="website" productShowcase={false} breadcrumbItems={[{ name: '首頁', url: '/' }, { name: 'JUPAS 收分 2026', url: '/universities/' }]}>
  <a class="skip-link" href="#quick-scores">跳至收分速查表</a>
  <header class="uni-nav"><a class="uni-brand" href="/"><img src="/logo-transparent-96.webp" alt="" width="40" height="40" /><span>DSE Jupas 神器</span></a><a href="/blog/">升學攻略</a></header>
  <main class="uni-main score-hub">
    <nav class="breadcrumbs" aria-label="麵包屑"><a href="/">首頁</a><span>/</span><span>JUPAS 收分 2026</span></nav>
    <header class="hub-hero">
      <p class="eyebrow">院校收生數據 / 2026 入學</p>
      <h1>JUPAS 收分 2026</h1>
      <p class="hero-intro">港大、科大、理大及都大已公布 2026 收分；其餘課程按實際資料年份列出。</p>
      <p class="hub-update">{snapshot.programmes.length} 個課程 · {publishedCount} 個已有 2026 數據 · 收分資料更新 <time datetime={updatedDate}>{displayDate}</time></p>
      <nav class="section-nav" aria-label="本頁內容"><a href="#quick-scores">全部課程收分</a><a href="#schools">院校介紹及年份</a><a href="#sources">官方資料來源</a></nav>
    </header>

    <section id="quick-scores" aria-labelledby="quick-scores-title" class="quick-scores-section">
      <h2 id="quick-scores-title">全部 {snapshot.programmes.length} 個課程收分</h2>
      <p class="quick-scores-intro">每列標明收分年份；未有 2026 數字時列最近有資料的年份，沒有數字則保留「—」。<strong>不同院校的分數不能直接比較</strong>，Median／LQ 亦非最低錄取線。</p>
      <div class="hub-filters" hidden>
        <label for="hub-school">院校<select id="hub-school" aria-controls="quick-scores-table"><option value="all">全部院校</option>{schoolEntries.map(({ slug, school }) => <option value={slug}>{school.shortName} {school.code}</option>)}</select></label>
        <label for="hub-year">收分資料年份<select id="hub-year" aria-controls="quick-scores-table"><option value="all">全部年份</option>{[2026, 2025, 2024, 2023].map(year => <option value={year}>{year}</option>)}<option value="none">未有數據</option></select></label>
        <label for="hub-search" class="hub-search-label">搜尋課程名稱或 JS 代碼<input id="hub-search" type="search" placeholder="例如：護理、JS3290" aria-controls="quick-scores-table" /></label>
        <button id="hub-reset" type="button">清除篩選</button>
      </div>
      <p id="hub-result-count" class="fine-print" role="status">顯示 {snapshot.programmes.length} / {snapshot.programmes.length} 個課程</p>
      <details class="hub-school-jumps"><summary>按院校跳至完整表格</summary><nav class="quick-school-nav" aria-label="跳至院校收分">{schoolEntries.map(({ slug, school, programmes }) => <a href={`#quick-${slug}`}>{school.shortName}<span class="quick-nav-count">{programmes.length}</span></a>)}</nav></details>
      <table id="quick-scores-table" class="quick-scores-table">
        <caption>完整列出網站現有課程，按院校及 JS 代碼排列。年份指學生入學年份；未有 2026 數字時列最近有資料的年份。只公布平均分的課程會另標「平均分」，不當作 Median。</caption>
        <thead><tr><th scope="col">院校及課程</th><th id="quick-year" scope="col">收分年份</th><th id="quick-median" scope="col">Median<br /><span>中位數</span></th><th id="quick-lq" scope="col">LQ<br /><span>下四分位數</span></th><th scope="col">來源／要求</th></tr></thead>
        {schoolEntries.map(({ slug, school, programmes }) => <tbody data-school-group={slug}>
          <tr class="quick-school-heading"><th id={`quick-${slug}`} colspan="5" scope="rowgroup"><div><span>{school.shortName} <span class="quick-school-code">{school.code} · {programmes.length} 個課程</span></span><a href={`/universities/${slug}/`}>院校分析及歷年分數 →</a></div></th></tr>
          {programmes.map(p => {
            const latest = latestRow(p);
            const source = latest?.year === 2026 && p.actual_2026_source ? p.actual_2026_source : school.official;
            const sourceLabel = latest?.year === 2026 && p.actual_2026_source ? '收分原文 ↗' : '官方要求 ↗';
            return <tr id={`quick-${p.js_code.toLowerCase()}`} data-programme={p.js_code} data-year={latest?.year ?? 'none'} data-school={slug} data-search={`${p.js_code} ${p.title} ${p.faculty ?? ''} ${school.name} ${school.shortName} ${school.code} ${institutionNames[p.institution] ?? ''}`.toLowerCase()}>
              <th id={`quick-course-${p.js_code}`} scope="row"><span class="course-code">{p.js_code}{p.js_code.startsWith('JSS') && ' · SSSDP'}</span><a class="course-title" href={programmePath(p)}>{p.title}</a>{slug === 'sssdp' && <span class="quick-institution-name">{institutionNames[p.institution] ?? p.institution}</span>}{latest?.year === 2026 && p.actual_2026_comparable_to_calculator === false && <span class="quick-formula-note">科目比重有改動，請按 2026 公式核對</span>}</th>
              <td headers={`quick-year quick-course-${p.js_code}`} class="quick-year"><span>{latest?.year ?? '未有數據'}</span>{latest && latest.year !== 2026 && <small>未有 2026 數字</small>}</td>
              <td headers={`quick-median quick-course-${p.js_code}`} data-score="median"><span class="quick-score-label" aria-hidden="true">Median · 中位數</span><strong>{formatScore(latest?.median)}</strong>{latest?.mean != null && <span class="quick-mean-note">只有平均分：{formatScore(latest.mean)}</span>}</td>
              <td headers={`quick-lq quick-course-${p.js_code}`} data-score="lq"><span class="quick-score-label" aria-hidden="true">LQ · 下四分位數</span><strong>{formatScore(latest?.lq)}</strong></td>
              <td class="quick-source"><a href={source} rel="external" aria-label={`${school.shortName} ${p.js_code} ${latest?.year === 2026 ? '2026 收分官方原文' : '官方課程要求'}`}>{sourceLabel}</a></td>
            </tr>;
          })}
        </tbody>)}
      </table>
      <p id="hub-no-results" class="hub-empty" hidden>找不到符合的課程。請試用較短名稱、JS 代碼，或清除篩選。</p>
      <p class="fine-print quick-scores-followup">點選課程查看歷年分數、計分方法及資料備註。<a href="/blog/jupas-admission-scores-2026/">Median、LQ、UQ 是甚麼？查看完整讀法 →</a></p>
    </section>

    <section id="schools" class="article-section" aria-labelledby="schools-title">
      <h2 id="schools-title">各大學 JUPAS 收分：全部課程及資料年份</h2>
      <p>院校有公布 2026 數字，不代表每個課程都有數據。各課程頁會標明實際年份；未有 2026 數字的課程保留較早年份供參考。</p>
      <div class="school-grid">{schoolEntries.map(({ slug, school, programmes, published }) => <a class="school-card" href={`/universities/${slug}/`}><span class="eyebrow">{school.name}</span><h3>{school.code}</h3><p>{school.intro}</p><div><span>{programmes.length} 個課程<br /><strong class="school-data-status">{published.length ? `${published.length} 個有 2026 數據` : '現有資料至 2025；未有 2026 數字'}</strong></span><strong>查看收分 →</strong></div></a>)}</div>
    </section>

    <section id="sources" class="article-section article-copy" aria-labelledby="sources-title">
      <h2 id="sources-title">2026 收生分數官方來源</h2>
      <p>速查表沿用院校公布的 2026 入學數字。公布文件及招生年度可能更新，查閱原文時請確認標示的入學年份。</p>
      <ul class="hub-source-list">{sources.map(({ href, id, school }) => <li id={id}><a href={href} rel="external">{school.shortName} {school.code} · 2026 收生分數{href.endsWith('.pdf') ? '（PDF）' : '及官方計分器'}</a></li>)}</ul>
      <p><a href="https://www.jupas.edu.hk/tc/page/detail/3667/" rel="external">JUPAS 官方：參與院校新生入學成績 →</a></p>
    </section>

    <section class="article-section article-copy"><h2>怎樣用收分表安排下一步？</h2><p>先確認課程最低要求，再按該年度公式計算自己的分數，與同一課程、同一口徑的 Median／LQ 比較。面試、作品集、志願 Band 及年度學額亦可能影響甄選。</p><p>港大頁設免費單課程試算；<a href="/blog/jupas-band-a-strategy/">JUPAS 志願排序指南</a>協助整理課程選擇。下一屆報名日子見<a href="/jupas-key-dates/">JUPAS 2027 重要日子</a>；其他升學路線見<a href="/dse-plan-b/">DSE 放榜 Plan B</a>。</p></section>
  </main>
</Layout>

<script>
  const filters = document.querySelector<HTMLElement>('.hub-filters');
  const school = document.querySelector<HTMLSelectElement>('#hub-school');
  const year = document.querySelector<HTMLSelectElement>('#hub-year');
  const search = document.querySelector<HTMLInputElement>('#hub-search');
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#quick-scores-table tr[data-programme]'));
  const groups = Array.from(document.querySelectorAll<HTMLTableSectionElement>('#quick-scores-table tbody'));
  const count = document.querySelector<HTMLElement>('#hub-result-count');
  const empty = document.querySelector<HTMLElement>('#hub-no-results');
  function filterRows() {
    const words = (search?.value ?? '').trim().toLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;
    for (const row of rows) {
      row.hidden = !((school?.value === 'all' || row.dataset.school === school?.value)
        && (year?.value === 'all' || row.dataset.year === year?.value)
        && words.every(word => row.dataset.search?.includes(word)));
      if (!row.hidden) visible++;
    }
    for (const group of groups) group.hidden = !Array.from(group.querySelectorAll<HTMLTableRowElement>('tr[data-programme]')).some(row => !row.hidden);
    if (count) count.textContent = `顯示 ${visible} / ${rows.length} 個課程`;
    if (empty) empty.hidden = visible > 0;
  }
  function resetFilters() {
    if (school) school.value = 'all';
    if (year) year.value = 'all';
    if (search) search.value = '';
    filterRows();
  }
  school?.addEventListener('change', filterRows);
  year?.addEventListener('change', filterRows);
  search?.addEventListener('input', filterRows);
  document.querySelector('#hub-reset')?.addEventListener('click', resetFilters);
  // Reveal an anchor target even when an earlier search hid its school or row.
  function revealTarget(hash: string) {
    const target = document.getElementById(hash.slice(1));
    if (target?.closest('[hidden]')) resetFilters();
    return target;
  }
  document.querySelector('.quick-school-nav')?.addEventListener('click', event => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a');
    if (link) revealTarget(link.hash);
  });
  window.addEventListener('hashchange', () => revealTarget(location.hash)?.scrollIntoView());
  revealTarget(location.hash);
  if (filters) filters.hidden = false;
</script>
