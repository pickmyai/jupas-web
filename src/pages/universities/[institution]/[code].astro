---
import Layout from '../../../layouts/Layout.astro';
import { schools, snapshot, official2027, formatScore as f, slugFor, programmePath, programmesFor, yearRows, latestRow, institutionNames, enrichmentFor, enrichmentVersion, popularityFor, scoreBasis } from '../../../lib/admissions';
import '../../../styles/universities.css';
import ScoreAppCta from '../../../components/ScoreAppCta.astro';
import StickyStoreBar from '../../../components/StickyStoreBar.astro';
import HeroAppCta from '../../../components/HeroAppCta.astro';

// One page per JUPAS programme, generated from the app's unified data
// (src/data/app-admissions.json via scripts/sync-app-data.py). No hand-kept numbers.
export function getStaticPaths() {
  return snapshot.programmes
    .filter(p => slugFor(p.institution))
    .map(p => ({ params: { institution: slugFor(p.institution), code: p.js_code.toLowerCase() }, props: { p } }));
}

const { p } = Astro.props;
const slug = slugFor(p.institution);
const school = schools[slug];
const uni = institutionNames[p.institution] ?? school.name;
const rows = yearRows(p);
const latest = latestRow(p);
const usesMean = latest && latest.median == null && latest.mean != null;
const earlierFormula = p.actual_2026_comparable_to_calculator === false;
const path = programmePath(p);
const url = `https://www.jupascalculator.app${path}`;
const modified = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Hong_Kong', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(snapshot.sourceUpdatedAt));
const info = enrichmentFor(p);
const isHkuSocialSciences = slug === 'hku' && p.js_code === 'JS6717';
const isHkuSocialSciencesElite = slug === 'hku' && p.js_code === 'JS6743';
// The 2027 joint intake is not a valid denominator for earlier JS6717 applications.
// Programme-specific public corrections. The legacy shared export need not be
// reinterpreted here: its cohort is not yet consistently verified.
const notices = {
  JSST04: { applicantsA: 181, offers: [63, 7, 5, 0, 0], grossFee: '168,350', netFee: '86,900' },
  JSST05: { applicantsA: 224, offers: [42, 18, 0, 0, 0], grossFee: '171,250', netFee: '89,800' },
};
const verified = slug === 'sssdp' ? notices[p.js_code] : undefined;
const officialProgramme = verified && `https://www.jupas.edu.hk/en/programme/sssdp/${p.js_code}/`;
const pop = (isHkuSocialSciences || verified) ? null : popularityFor(p);
const jupasProgramme = `https://web.jupas.edu.hk/en/programme/hku/${p.js_code}/`;
const paths = info.career_paths ?? [];
const perPlace = pop && pop.perPlace.toFixed(1);
// Applicants per place measures how many people apply, not how hard it is to
// get in: top programmes (e.g. medicine) draw fewer but higher-scoring
// applicants. Say so rather than calling them "less contested".
const popRead = pop && `2025 年每個學額約有 ${perPlace} 名 Band A 申請者。`;

function describe(r) {
  if (!r) return `${uni}並未公布此課程的收生分數`;
  const parts = [];
  if (r.median != null) parts.push(`中位數（Median）${f(r.median)} 分`);
  else if (r.mean != null) parts.push(`平均分 ${f(r.mean)} 分`);
  if (r.lq != null) parts.push(`下四分位數（LQ）${f(r.lq)} 分`);
  if (r.uq != null) parts.push(`上四分位數（UQ）${f(r.uq)} 分`);
  return `${scoreBasis(r)}：${parts.join('、')}`;
}
const lead = `${uni}「${p.title}」（${p.js_code}）${describe(latest)}${(p.scoring_method_label ?? p.scoring_method) ? `；${earlierFormula ? "較早參考計法" : "計分方法"}為 ${(p.scoring_method_label ?? p.scoring_method)}` : ''}。`;
const headline = latest ? (usesMean ? `平均分 ${f(latest.mean)}` : latest.median != null ? `Median ${f(latest.median)}${latest.lq != null ? `・LQ ${f(latest.lq)}` : ''}` : `LQ ${f(latest.lq)}・UQ ${f(latest.uq)}`) : '收生分數';
// Code, school, year and score first so the part searchers scan survives SERP truncation of long programme names.
const status2027 = p.offered_2027 === false ? (p.successors_2027?.length ? `｜2027 改為 ${p.successors_2027.join('／')}` : '｜2027 不再招生') : '';
const title = (latest
  ? `${p.js_code} ${school.shortName === '自資院校' ? uni : school.shortName} ${latest.year} 收分 ${headline}｜${p.title}`
  : `${p.js_code} ${school.shortName === '自資院校' ? uni : school.shortName} 收生分數｜${p.title}`) + status2027;
const description = isHkuSocialSciencesElite
  ? `${lead} 2027 年新課程，仍待批准；暫無歷年收生分數。`
  : `${lead}附 ${rows.map(r => r.year).sort().join('、')} 年分數、計分方法${(pop || isHkuSocialSciences || verified) ? '、Band A 申請人數' : ''}${paths.length ? '、畢業出路及起薪' : ''}。`;

const notes = [
  isHkuSocialSciences
    ? '2026 年收生分數（上四分位數、中位數、下四分位數）來自港大《2026 JUPAS Admissions Scores》，按 2026 年主要遴選準則計算。'
    : p.actual_2026_note ?? p.data_remark,
].filter(Boolean);

const siblings = programmesFor(school.code)
  .filter(x => x.js_code !== p.js_code)
  .map(x => ({ x, r: latestRow(x) }))
  .sort((a, b) => (b.r?.median ?? b.r?.mean ?? 0) - (a.r?.median ?? a.r?.mean ?? 0))
  .slice(0, 12);

const faqPairs = [
  latest && { question: `${p.js_code} ${p.title} ${latest.year} 年收生分數是多少？`, answer: `${describe(latest)}。數字為已取錄學生的分數分布，不是最低錄取線，亦不能預測下一年。` },
  (p.scoring_method_label ?? p.scoring_method) && { question: `${p.js_code} 用甚麼計分方法？`, answer: `${(p.scoring_method_label ?? p.scoring_method)}${p.weighting_detail ? `；${p.weighting_detail}` : ''}。` },
  verified && { question: `${p.js_code} ${p.title}有幾多人報？`, answer: `JUPAS 2026 年完成修改課程選擇後，Band A 申請者為 ${verified.applicantsA} 人。這是過往申請人數，不是錄取機率。` },
  pop && { question: `${p.js_code} ${p.title}有幾多人報？`, answer: `2025 年有 ${pop.applicants} 名 Band A 申請者，學額 ${pop.places} 個，即每個學額約 ${perPlace} 人。申請人數不代表入學難度，須同時參考收生分數。` },
].filter(Boolean);
---
<Layout title={title} description={description} schemaType="article" productShowcase={false}
  articleData={{ title, description, url, datePublished: modified, dateModified: modified }}
  faqPairs={faqPairs}
  breadcrumbItems={[{ name: '首頁', url: 'https://www.jupascalculator.app/' }, { name: '院校收生分數', url: 'https://www.jupascalculator.app/universities/' }, { name: `${school.shortName}收生分數`, url: `https://www.jupascalculator.app/universities/${slug}/` }, { name: p.js_code, url }]}>
  <header class="uni-nav"><a class="uni-brand" href="/"><img src="/logo-transparent-96.webp" alt="" width="40" height="40" /><span>DSE Jupas 神器</span></a><a href="/universities/">院校收分</a><a href="/blog/">升學攻略</a></header>
  <main id="article" class="uni-main">
    <nav class="breadcrumbs" aria-label="麵包屑"><a href="/">首頁</a><span>/</span><a href="/universities/">院校收生分數</a><span>/</span><a href={`/universities/${slug}/`}>{school.code}</a><span>/</span><span>{p.js_code}</span></nav>
    <header class="uni-hero">
      <div><p class="eyebrow">{uni}{p.faculty ? ` · ${p.faculty}` : ''}</p>
        <h1>{p.title}<span>{p.js_code} 收生分數</span></h1>
        <p class="hero-intro">{lead}</p>
        <HeroAppCta text={isHkuSocialSciencesElite ? `在 App 輸入你的 DSE 成績，按港大公布的最佳五科計分方法計算 ${p.js_code} 參考分數。` : `在 App 輸入你的 DSE 成績，按 ${p.js_code} 的計分方法計算分數，並即時看到與歷年 Median、LQ 相差多少。`} />
        {p.title_2026 && <p class="data-note">JUPAS 2027 年起課程名稱改為「{p.title}」；2026 年及以前的收生分數以舊名「{p.title_2026}」公布，課程編號不變。<a href={official2027.changes} rel="nofollow">JUPAS 課程變更 ↗</a></p>}
        {p.offered_2027 === false && <p class="data-note">此課程不在 JUPAS 2027 年課程名單內{p.successors_2027?.length ? `，2027 年改為 ${p.successors_2027.join('、')} 分開招生` : ''}；下表為過往收生分數，只供參考。<a href={official2027.changes} rel="nofollow">JUPAS 課程變更 ↗</a></p>}
      </div>
      {latest && <aside class="edition-card"><span>{scoreBasis(latest)}</span><strong>{usesMean ? f(latest.mean) : f(latest.median)}</strong><p>{usesMean ? '平均分' : latest.median != null ? 'Median（中位數）' : '未公布中位數／平均分'}</p><p>{latest.lq != null && `LQ ${f(latest.lq)}`}{latest.lq != null && latest.uq != null && ' · '}{latest.uq != null && `UQ ${f(latest.uq)}`}</p></aside>}
    </header>

    {isHkuSocialSciencesElite
      ? <ScoreAppCta compact heading="用 Best 5 試算 JS6743 分數" body="按港大公布的最佳五科計分方法計算參考分數。此課程暫無歷年中位數或下四分位數，不能用作收生差距比較。" />
      : <ScoreAppCta shot heading={`你的成績夠不夠入讀 ${p.js_code}？`} body={`在 DSE Jupas 神器輸入各科成績，App 按${uni}此課程的計分方法計算你的分數。計分器免費使用。`} points={[`按 ${p.js_code} 的選科要求及科目比重計分，不用自行翻查課程資料`, `顯示你的分數與下表 Median、LQ 相差多少`, `反推哪幾科需要進步多少才達到 Median 或 LQ`]} />}

    <section id="scores" class="article-section">
      <h2>歷年收生分數</h2>
      {rows.length ? <div class="score-table-scroll" tabindex="0" role="region" aria-label={`${p.js_code} 歷年收生分數`}>
        <table class="programme-years"><caption>取錄年份、計分公式及統計種類分開標示；「—」為未公布。</caption>
          <thead><tr><th scope="col">取錄年份／基準</th><th scope="col">UQ</th><th scope="col">中位數</th><th scope="col">平均分</th><th scope="col">LQ</th></tr></thead>
          <tbody>{rows.map(r => <tr><th scope="row">{scoreBasis(r)}</th><td>{f(r.uq)}</td><td class="latest-score">{f(r.median)}</td><td class="latest-score">{f(r.mean)}</td><td>{f(r.lq)}</td></tr>)}</tbody>
        </table>
      </div> : <p>{p.actual_2026_no_score ? '院校未有公布此課程的收生分數（例如取錄人數不足）。' : '暫未有此課程的收生分數。'}</p>}
      {notes.map(n => <p class="data-note">{n}</p>)}
      {p.actual_2026_source && <p class="fine-print">2026 年資料來源：<a href={p.actual_2026_source} rel="nofollow">{uni}官方公布 ↗</a></p>}
      {!isHkuSocialSciencesElite && <ScoreAppCta heading={`哪幾科要進步多少才夠 ${p.js_code}？`} body={`App 按你的成績反推：要達到上表 Median 或 LQ，哪幾科需要升級、各升多少。另可把課程加入志願，排好 Band A 至 Band B。`} />}
    </section>

    {isHkuSocialSciences && <section id="popularity" class="article-section">
      <h2>2026 年 JUPAS 申請及正式遴選結果</h2>
      <dl class="pop-stats">
        <div><dt>改選後 Band A 申請</dt><dd>192</dd></div>
        <div><dt>正式遴選 Band A 取錄通知</dt><dd>47</dd></div>
        <div><dt>正式遴選 Band B 至 E 取錄通知</dt><dd>0</dd></div>
      </dl>
      <p>2027 年入學首年學額：JS6717 與 JS6743 合計 72 個，並非 JS6717 的獨立學額。<a href={jupasProgramme} rel="nofollow">JUPAS 官方課程資料及統計 ↗</a></p>
    </section>}

    {isHkuSocialSciencesElite && <section id="programme-intake" class="article-section">
      <h2>2027 年首年學額</h2>
      <p>JS6717 與 JS6743 合計 72 個學額，並非 JS6743 的獨立學額。<a href={jupasProgramme} rel="nofollow">JUPAS 官方課程資料 ↗</a></p>
    </section>}

    {verified && <section id="popularity" class="article-section">
      <h2>{p.js_code} 2026 年 JUPAS 申請及主輪取錄</h2>
      <dl class="pop-stats">
        <div><dt>Band A 申請（修改課程選擇後）</dt><dd>{verified.applicantsA}</dd></div>
        <div><dt>主輪取錄（公布結果時）</dt><dd>{verified.offers.reduce((total, count) => total + count, 0)}</dd></div>
        {verified.offers.map((count, index) => <div><dt>Band {'ABCDE'[index]} 取錄</dt><dd>{count}</dd></div>)}
      </dl>
      <p>以上為過往數字，不代表下一年取錄機率。<a href={officialProgramme}>JUPAS 官方統計 ↗</a></p>
    </section>}

    {pop && <section id="popularity" class="article-section">
      <h2>{p.js_code} 申請熱度：<span class={`pop-tier pop-${pop.percentile >= 75 ? 'hot' : pop.percentile >= 25 ? 'mid' : 'low'}`}>{pop.tier}</span></h2>
      <dl class="pop-stats">
        <div><dt>Band A 申請</dt><dd>{pop.applicants}</dd></div>
        <div><dt>學額</dt><dd>{pop.places}</dd></div>
        <div><dt>每學額人數</dt><dd>{perPlace}</dd></div>
        {pop.offers != null && <div><dt>Band A 取錄</dt><dd>{pop.offers}</dd></div>}
        {pop.otherOffers != null && <div><dt>Band A 以外取錄</dt><dd>{pop.otherOffers}（{Math.round(pop.otherShare * 100)}%）</dd></div>}
      </dl>
      {pop.otherOffers != null && <p>{pop.otherOffers === 0
        ? `${p.js_code} 全部 ${pop.admitted} 個取錄都給予 Band A 考生，把此課程排在 Band B 或以後的考生沒有獲取錄。`
        : `${p.js_code} 共 ${pop.admitted} 個取錄，其中 ${pop.otherOffers} 個（${Math.round(pop.otherShare * 100)}%）給予把此課程排在 Band A 以外的考生。JUPAS 沒有把 Band B 與 Band C 至 E 分開公布，此數為合計；比例越高，排在 Band B 仍有取錄的機會越大。`}</p>}
      <p>{popRead}在{school.shortName === '自資院校' ? uni : school.shortName} {pop.peers} 個有數據的課程中，每學額申請人數排第 {pop.rank}。申請熱度只反映報讀人數，不代表入學難度：分數要求高的課程，申請者多數本身成績已高，應同時參考上面的 Median 及 LQ。</p>
      <p class="fine-print">數字為 JUPAS 2025 年官方統計；申請熱度按每學額 Band A 申請人數，與全部有數據的 JUPAS 課程比較分級。</p>
    </section>}

    {info.overview?.length > 0 && <section id="overview" class="article-section article-copy">
      <h2>{p.title}課程簡介</h2>
      <ul>{info.overview.map(x => <li>{x}</li>)}</ul>
      {verified && <>
        <p><strong>2027/28 學年首年學費：</strong>符合資格者扣除 SSSDP 資助後為 HK${verified.netFee}；未扣資助為 HK${verified.grossFee}。以教育局最終批准為準，學費及資助額或按年調整。</p>
        <p><strong>另收臨床實習費：</strong>每學年 HK$20,000，按年調整，不包括在上述學費內。<a href={officialProgramme}>JUPAS 官方費用詳情 ↗</a></p>
      </>}
      {!verified && info.tuition_annual && <p><strong>學費：</strong>每年約 HK${Number(info.tuition_annual).toLocaleString('en-HK')}{info.tuition_note ? `（${info.tuition_note}）` : ''}</p>}
    </section>}

    <section id="scoring" class="article-section article-copy">
      <h2>{p.js_code} 計分方法{earlierFormula ? '（較早參考）' : p.scoring_formula_year ? `（${p.scoring_formula_year} 公式）` : ''}</h2>
      {earlierFormula && <p class="data-note">以下列出較早的參考計法；尚未確認可與上方 2026 分數直接比較，請先核對院校最新公式。</p>}
      {(p.scoring_method_label ?? p.scoring_method) && <p><strong>計分：</strong>{(p.scoring_method_label ?? p.scoring_method)}</p>}
      <p><strong>科目比重：</strong>{p.weighting_detail || '資料未列額外科目比重。'}</p>
      <p><strong>等級換算：</strong>{p.bonus_system ? '5** = 8.5、5* = 7、5 = 5.5、4 = 4、3 = 3（加分制）。' : '5** = 7、5* = 6、5 = 5、4 = 4、3 = 3。'}</p>
      {isHkuSocialSciences
        ? <p><strong>面試：</strong>不設面試。</p>
        : isHkuSocialSciencesElite
          ? <p><strong>面試：</strong>港大會邀請部分申請人面試，暫列 1 月至 6 月，以港大通知為準。<a href="https://www.admissions.hku.hk/apply/jupas/interview" rel="nofollow">港大面試時間表 ↗</a></p>
          : p.interview && <p><strong>面試：</strong>此課程設面試。</p>}
      {p.other_considerations && <p><strong>其他考慮因素：</strong>{p.other_considerations}</p>}
      <p>Median 是已取錄學生分數的中位數；LQ、UQ 是下、上四分位數。LQ 並非最低錄取線，分數高於 Median 也不代表一定取錄。<a href="/blog/jupas-admission-scores-2026/">閱讀 Median／LQ 的完整讀法</a>。</p>
    </section>

    {((slug === 'polyu' && p.offered_2027 !== false) || p.entry_req) && <section id="entry-requirements" class="article-section article-copy">
      <h2>{p.js_code} 入學要求</h2>
      {slug === 'polyu' && p.offered_2027 !== false && <>
        <p><strong>理大聯招最低要求</strong>為文憑試中文及英文各 3 級，數學必修部分 2 級，公民與社會發展科達標，另有兩科選修達 3 級。M1 或 M2 可算作一科選修。</p>
        <p>重考生、應用學習及其他語言科的安排見<a href="https://www.polyu.edu.hk/study/ug/admissions/jupas/jupas-general-entrance-requirements">理大聯招最低入學要求</a>。</p>
      </>}
      {p.entry_req && <p><strong>課程要求</strong> {p.entry_req}</p>}
    </section>}

    {(paths.length > 0 || info.careers?.length > 0) && <section id="careers" class="article-section">
      <h2>{p.title}畢業出路及起薪</h2>
      {info.careers?.length > 0 && <ul class="career-notes">{info.careers.map(x => <li>{x}</li>)}</ul>}
      {paths.length > 0 && <div class="score-table-scroll" tabindex="0" role="region" aria-label={`${p.js_code} 畢業出路起薪`}>
        <table class="programme-years"><caption>首年月薪為港幣參考範圍（k＝千元），整理自公開招聘及薪級資料。</caption>
          <thead><tr><th scope="col">出路</th><th scope="col">首年月薪</th></tr></thead>
          <tbody>{paths.map(c => <tr><th scope="row">{c.title}{c.needs_further_qualification && <span class="path-note">需另考專業資格</span>}</th><td>{c.salary_y1 ? `$${c.salary_y1}` : '—'}</td></tr>)}</tbody>
        </table>
      </div>}
    </section>}

    {!isHkuSocialSciencesElite && <aside class="app-next"><div><p class="eyebrow">用你的成績計算</p><h2>{p.js_code} 你有幾多分？</h2><p>DSE Jupas 神器按{uni}此課程的計分方法計算你的分數，並與歷年 Median、LQ 比較；還可以反推哪幾科需要進步多少才達標。App 內另有六項出路評級，以及入職 10 年、20 年的薪酬走勢。計分器免費使用。</p></div><div class="store-links"><a href="https://apps.apple.com/app/id6780134101">iPhone / iPad 下載</a><a href="https://play.google.com/store/apps/details?id=app.jupas.dse">Android 下載</a></div></aside>}

    {siblings.length > 0 && <section class="article-section">
      <h2>{school.shortName}其他課程收生分數</h2>
      <ul class="sibling-list">{siblings.map(({ x, r }) => <li><a href={programmePath(x)}><span>{x.js_code} {x.title}</span><strong>{r ? `${r.year} ${r.median != null ? `Median ${f(r.median)}` : r.mean != null ? `平均 ${f(r.mean)}` : `LQ ${f(r.lq)}`}` : '—'}</strong></a></li>)}</ul>
      <p><a href={`/universities/${slug}/`}>查看{school.shortName}全部 {programmesFor(school.code).length} 個課程 →</a></p>
    </section>}

