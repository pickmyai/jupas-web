---
// 收分頁首屏下載入口。
//
// 2026-11-27 web-click-stats（28 日）：首頁 14.25%、/en/ 15.24%，院校頁只有 0.3–2.7%。
// 首頁的商店按鈕放在首屏標題下面，並列出 App 實際做到的事；院校頁的第一個下載框
// 排在首屏以下（iPhone 375×812 約 860px 處），讀者未看到就開始查表。
// 所以把官方商店徽章搬到 hero 介紹之後，並用一句寫明 App 為這一頁讀者做甚麼。
//
// 商店點擊沿用 Layout.astro 的 web_clicks beacon（按 href 捕捉），不需另加追蹤。
interface Props {
  text: string;
}
const { text } = Astro.props;
---
<div class="hero-app-cta">
  <p>{text}</p>
  <div class="hero-app-cta__stores">
    <a href="https://apps.apple.com/app/id6780134101" rel="noopener"><img src="/ios-icon.png" alt="在 App Store 免費下載 DSE Jupas 神器" width="144" height="43" /></a>
    <a href="https://play.google.com/store/apps/details?id=app.jupas.dse" rel="noopener"><img src="/android-icon.png" alt="在 Google Play 免費下載 DSE Jupas 神器" width="145" height="43" /></a>
  </div>
</div>

<style>
  .hero-app-cta{margin-top:22px;max-width:640px}
  .hero-app-cta p{margin:0 0 12px;font-size:15px;font-weight:700;line-height:1.55;color:#172b36}
  .hero-app-cta__stores{display:flex;flex-wrap:wrap;gap:10px}
  .hero-app-cta__stores a{display:inline-flex;border-radius:8px}
  .hero-app-cta__stores a:hover{opacity:.88}
  .hero-app-cta__stores img{display:block;height:43px;width:auto}
  @media(max-width:760px){
    .hero-app-cta{margin-top:18px}
    .hero-app-cta p{font-size:14px}
    .hero-app-cta__stores img{height:40px}
  }
</style>
