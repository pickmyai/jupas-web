---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ProductFooter from '../components/ProductFooter.astro';
import { LANGUAGES } from '../components/LandingPage';

interface ArticleData {
	title: string;
	description: string;
	url: string;
	image?: string;
	datePublished?: string;
	dateModified?: string;
}

interface Props {
	title: string;
    description?: string;
    lang?: string;
    ogImage?: string;
    keywords?: string;
    noindex?: boolean;
    schemaType?: 'website' | 'mobileApplication' | 'article';
    articleData?: ArticleData;
    breadcrumbItems?: Array<{ name: string; url: string }>;
    faqItems?: Array<{ q: string; a: string }>;
    alternates?: Array<{ lang: string; url: string }>;
    showProductFooter?: boolean;
    // false: keep the site footer but drop the family product showcase.
    productShowcase?: boolean;
}

const {
	title,
	description = "DSE Jupas 神器提供 JUPAS 課程計分、歷年收生資料參考、出路評級、志願排序分析及大學面試練習。非官方升學參考工具。",
	lang = "zh-HK",
	ogImage,
	keywords,
	noindex = false,
	schemaType = 'mobileApplication',
	articleData,
	breadcrumbItems,
	faqItems,
	alternates: providedAlternates,
	showProductFooter = true,
	productShowcase = true,
} = Astro.props;

// Every page title carries the brand so the site owns the "jupas 神器" query.
const brand = lang.startsWith('zh') ? 'DSE Jupas 神器' : 'DSE Jupas';
const fullTitle = title.includes(brand) ? title : `${title}｜${brand}`;

const isLocalizedHome = ['/', '/en/', '/zh-cn/'].includes(Astro.url.pathname);
const alternates = providedAlternates ?? (isLocalizedHome
    ? LANGUAGES.map(l => ({
        lang: l.code,
        url: l.code === 'zh-HK' ? '/' : `/${l.code.toLowerCase()}/`,
    }))
    : []);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="vvhtX6UkDycwd5jxCOf5IdoJeHAheh_w-VpFmqIx3BM" />

		<SEO
			title={fullTitle}
			description={description}
			lang={lang}
			ogImage={ogImage}
			keywords={keywords}
			noindex={noindex}
			alternates={alternates}
		/>

		<StructuredData type={schemaType} articleData={articleData} breadcrumbItems={breadcrumbItems} faqItems={faqItems} />

		<title>{fullTitle}</title>
			<script is:inline>
		// Google Ads 搜尋廣告轉換（2026-11-17）：只在由廣告進站（URL 有 gclid／gbraid／wbraid）
		// 或 90 日內曾由廣告進站的瀏覽器載入 gtag；按 App Store／Google Play 連結時記一次
		// 「網站商店按鈕點擊」轉換。一般自然流量不載入任何 Google 代碼。
		(function () {
			try {
				var AW = 'AW-18574801110', KEY = 'pm_gads_ts', store = null;
				try { store = window.localStorage; } catch (e) {}
				var q = new URLSearchParams(location.search);
				var fromAd = q.has('gclid') || q.has('gbraid') || q.has('wbraid');
				if (fromAd && store) { try { store.setItem(KEY, String(Date.now())); } catch (e) {} }
				var ts = 0;
				if (store) { try { ts = +store.getItem(KEY) || 0; } catch (e) {} }
				if (!fromAd && !(ts && Date.now() - ts < 90 * 864e5)) return;
				window.dataLayer = window.dataLayer || [];
				window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
				window.gtag('js', new Date());
				window.gtag('config', AW);
				var s = document.createElement('script');
				s.async = true;
				s.src = 'https://www.googletagmanager.com/gtag/js?id=' + AW;
				document.head.appendChild(s);
				document.addEventListener('click', function (event) {
					var link = event.target && event.target.closest && event.target.closest('a[href*="apps.apple.com"], a[href*="play.google.com"]');
					if (link) window.gtag('event', 'conversion', { send_to: AW + '/N_AICJSWnLodENbxk5lF', transport_type: 'beacon' });
				}, true);
			} catch (err) {}
		})();
		</script>
	</head>
	<body class="bg-background text-foreground antialiased font-sans">
		<slot />
		{showProductFooter && <ProductFooter currentProductId="jupas" lang={lang} showcase={productShowcase} />}
		<script is:inline>
		document.addEventListener('click', function (e) {
		  var a = e.target && e.target.closest && e.target.closest('a[href*="apps.apple.com"], a[href*="play.google.com"]');
		  if (!a) return;
		  // Same production gate as the page-view beacon, so local previews do not add clicks.
		  if (location.hostname !== 'jupascalculator.app' && location.hostname !== 'www.jupascalculator.app') return;
		  var href = a.href || '';
		  var platform = href.indexOf('apps.apple.com') !== -1 ? 'ios' : 'android';
		  var m = platform === 'ios' ? href.match(/id(\d{8,})/) : href.match(/[?&]id=([\w.]+)/);
		  try {
		    var p = new URLSearchParams({ site: 'jupas', app: (m && m[1]) || '', platform: platform, page: location.pathname });
		    if (!(navigator.sendBeacon && navigator.sendBeacon('https://www.pickmyquiz.com/api/track/app-click', p))) {
		      fetch('https://www.pickmyquiz.com/api/track/app-click', { method: 'POST', body: p, keepalive: true });
		    }
		  } catch (err) {}
		}, true);
		</script>
		<script is:inline>
		// Page views into the same web_clicks table as the store clicks below, so
		// web-click-stats can compute a real CTR instead of leaving the denominator
		// null. `app` is omitted on purpose: this site fronts more than one app, so
		// a view cannot be attributed to one of them the way a store click can.
		// Host-gated to production so preview builds stay out of the numbers.
		try {
			if (location.hostname === 'jupascalculator.app' || location.hostname === 'www.jupascalculator.app') {
				var __pv = new URLSearchParams({ site: 'jupas', page: location.pathname });
				if (!(navigator.sendBeacon && navigator.sendBeacon('https://www.pickmyquiz.com/api/track/page-view', __pv))) {
					fetch('https://www.pickmyquiz.com/api/track/page-view', { method: 'POST', body: __pv, keepalive: true });
				}
			}
		} catch (err) {}
		</script>
		<script src="https://www.pickmyquiz.com/js/content-report-widget.js" data-site="jupas" defer></script>
	</body>
</html>
<style is:global>
	* { box-sizing: border-box; }
	.font-sans { font-family: -apple-system, BlinkMacSystemFont, 'PingFang TC', 'Microsoft JhengHei', 'Segoe UI', sans-serif; }
	.gradient-text { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
	.hero-gradient { background: linear-gradient(135deg, #fffbeb 0%, #fff 50%, #f0f9ff 100%); }
	.cta-gradient { background: linear-gradient(135deg, #f59e0b 0%, #d97706 60%, #b45309 100%); }
	.card-hover { transition: transform 0.25s ease, box-shadow 0.25s ease; }
	.card-hover:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(245,158,11,0.12); }
	:root {
		--background: 0 0% 100%;
		--foreground: 222.2 84% 4.9%;

		--card: 0 0% 100%;
		--card-foreground: 222.2 84% 4.9%;
 
		--popover: 0 0% 100%;
		--popover-foreground: 222.2 84% 4.9%;
 
		--primary: 38 92% 50%; /* #f59e0b Amber (star brand) */
		--primary-foreground: 210 40% 98%;
 
		--secondary: 210 40% 96.1%;
		--secondary-foreground: 222.2 47.4% 11.2%;
 
		--muted: 210 40% 96.1%;
		--muted-foreground: 215.4 16.3% 46.9%;
 
		--accent: 210 40% 96.1%;
		--accent-foreground: 222.2 47.4% 11.2%;
 
		--destructive: 0 84.2% 60.2%;
		--destructive-foreground: 210 40% 98%;

		--border: 214.3 31.8% 91.4%;
		--input: 214.3 31.8% 91.4%;
		--ring: 38 92% 50%;
 
		--radius: 0.75rem;
	}
 
	.dark {
		--background: 222.2 84% 4.9%;
		--foreground: 210 40% 98%;
 
		--card: 222.2 84% 4.9%;
		--card-foreground: 210 40% 98%;
 
		--popover: 222.2 84% 4.9%;
		--popover-foreground: 210 40% 98%;
 
		--primary: 38 92% 50%;
		--primary-foreground: 0 0% 100%;
 
		--secondary: 217.2 32.6% 17.5%;
		--secondary-foreground: 210 40% 98%;
 
		--muted: 217.2 32.6% 17.5%;
		--muted-foreground: 215 20.2% 65.1%;
 
		--accent: 217.2 32.6% 17.5%;
		--accent-foreground: 210 40% 98%;
 
		--destructive: 0 62.8% 30.6%;
		--destructive-foreground: 210 40% 98%;
 
		--border: 217.2 32.6% 17.5%;
		--input: 217.2 32.6% 17.5%;
		--ring: 38 92% 50%;
	}

    html {
        scroll-behavior: smooth;
    }
</style>
