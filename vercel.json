{
    "trailingSlash": true,
    "redirects": [
        {
            "source": "/zh-hk",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/zh-hk/",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/zh-hk/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/zh-hk/:path*/",
            "destination": "/",
            "permanent": true
        }
    ]
}
